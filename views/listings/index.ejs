<% layout("/layouts/boilerplate.ejs") %>
<body>
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 1rem;
      opacity: 0.8;
    }

    .filter:hover {
      opacity: 1;
    }

    .filter p {
      font-size: 0.8rem;
    }
  </style>

  <div class="banner-container">
    <h2 class="banner-title">🏡 Discover Amazing Places</h2>
    <ul>
      <li class="banner">
        <div class="box">🏖️ Beach Houses</div>
        <div class="box">🏔️ Mountain Cabins</div>
        <div class="box">🏙️ City Apartments</div>
        <div class="box">🏰 Luxury Villas</div>
        <div class="box">🏡 Cozy Cottages</div>
        <div class="box">🌴 Tropical Retreats</div>
        <div class="box">🎿 Ski Chalets</div>
        <div class="box">🏖️ Ocean Views</div>
        <div class="box">🌲 Forest Hideaways</div>
        <div class="box">🏛️ Historic Homes</div>
        <div class="box">🏕️ Unique Stays</div>
        <div class="box">🏡 Family Friendly</div>
        <div class="box">💑 Romantic Getaways</div>
        <div class="box">🌅 Sunrise Views</div>
        <div class="box">🏖️ Beachfront</div>
        <div class="box">🏔️ Mountain Views</div>
      </li>
    </ul>
  </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listing of allListings) {%>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b>
            <br />
            &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
          </p>
        </div>
      </div>
    </a>
    <%}%>
  </div>
</body>
