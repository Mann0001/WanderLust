<% if (showHeaderFooter) { %>
<nav
  class="navbar navbar-expand-md bg-body-light border-bottom sticky-top mb-3"
>
  <div class="container-fluid">
    <div class="d-block d-md-none navbar-brand">
      <a href="/listings"><h3>WanderLust</h3></a>
    </div>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav d-flex align-items-center mb-2">
        <a class="nav-link d-flex align-items-center gap-2" href="/listings">
          <i class="fa-regular fa-compass me-2"></i>
          <span>Explore</span>
        </a>
      </div>

      <div class="navbar-nav ms-auto">
        <form class="d-flex justify-content-center mb-2" role="search">
          <div class="search-wrapper">
            <input
              class="form-control"
              type=""
              placeholder="Search destinations"
            />
            <button class="btn btn-search" type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </form>
      </div>

      <div class="navbar-nav ms-auto d-flex align-items-center">
        <a class="nav-link underline-hover" href="/listings/new"
          >Become a host</a
        >
        <% if(!currUser) {%>
        <a class="nav-link" href="/login"><b>Login</b></a>
        <a
          class="btn btn-outline-danger btn-signup d-none d-md-block"
          href="/signup"
          ><b>Signup</b></a
        >
        <a
          class="btn btn-outline-danger btn-signup d-md-none mb-3"
          href="/signup"
          ><b>Signup</b></a
        >
        <% } %> <% if(currUser) {%>
        <a class="nav-link underline-hover" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
<% } %>
